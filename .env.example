# 可选 LLM 增强模式：仅在本机 .env 或系统环境变量中填写密钥。
# .env 已被 .gitignore 排除。请勿把真实密钥提交、复制到 README 或粘贴到应用页面。
OPENAI_API_KEY=
LLM_PROVIDER=openai
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# 可选：不填写时使用应用默认模型。
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=1
OPENAI_MAX_OUTPUT_TOKENS=6000
# 共享每日预算（Asia/Hong_Kong 日界线）；重试按最坏次数预留，失败不退款。
LLM_DAILY_REQUEST_LIMIT=20
LLM_DAILY_TOKEN_BUDGET=2000000
LLM_SESSION_REQUEST_LIMIT=5
# 0 表示不启用金额预算；要启用必须填写账户模型的实际单价。
LLM_DAILY_USD_BUDGET=0
LLM_INPUT_USD_PER_MILLION=0
LLM_OUTPUT_USD_PER_MILLION=0
QUOTA_DB_PATH=runtime/quota.sqlite3
TENANT_ID=default
TENANT_DAILY_REQUEST_LIMIT=20
TENANT_DAILY_TOKEN_BUDGET=2000000
# 本机 development 可不配置口令。production 必须配置下列三项。
APP_ENV=development
APP_ACCESS_PASSWORD=
SERVICE_OPERATOR=
SERVICE_CONTACT=
